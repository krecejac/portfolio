# Frontend environment variables (copy to .env.local and fill in).

# Backend API base URL. Defaults to http://localhost:3001 when unset.
VITE_API_URL=

# Windy Map Forecast API key (for the marine-weather map on /maps).
# Get one free at https://api.windy.com/. Note: this is a client-side key and
# is visible in the browser bundle; protect it with domain restrictions.
VITE_WINDY_KEY=
